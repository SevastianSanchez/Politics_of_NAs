.DS_Store
._.DS_Store
**/.DS_Store
**/._.DS_Store
.Rproj.user

# The bulk UN SDG goal exports only (310 MB). Too large to track; the README
# documents re-downloading them. Everything else in 01_data/raw/ is small
# and IS tracked, including sdg_update_info.xlsx, so a fresh clone can run
# build_series_stability.R without re-downloading anything.
01_data/raw/un_sdg_exports/

# Local R session files
.RData
.RDataTmp*
.Rhistory

# Local tooling and private material (kept on disk, never pushed)
.claude/
_private_archive/

# R workspace dumps
*.RData

# Bifactor fit checkpoint: an intermediate the script writes every 50 cycles so
# a long run survives a closed laptop. Rebuilt by build_irt_vsi_goal_relative.R.
01_data/vsi_scores/vsi_goal_relative/irt_vsi_goal_relative_ckpt.rds

# Per-replicate checkpoints of the two bootstrap checks; regenerated on a run.
01_data/vsi_scores/vsi_goal_relative/boot_ck/
01_data/vsi_scores/vsi_goal/boot_ck/

# Claude Code instructions: local only, never pushed
CLAUDE.md

# Release upload folders, built by 04_publish/build_release_bundle.R; uploaded to Zenodo, never committed
_release/

# Local notes, kept on disk, never pushed
misc/
